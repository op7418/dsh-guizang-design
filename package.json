{
  "name": "dsh-guizang-design",
  "version": "0.1.4",
  "description": "歸藏设计 · DeepSeek Harness 插件：网页 PPT、图文卡片、网页排版、去 AI 味四个 skill，一套设计系统；展示库收着官方示例和你做过的作品，一键做同风格的下一份。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "scripts",
    "skills",
    "gallery",
    "examples",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.png",
    "own-skills",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skills",
    "ppt",
    "design-system",
    "typography"
  ],
  "author": "op7418",
  "homepage": "https://github.com/op7418/dsh-guizang-design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/op7418/dsh-guizang-design.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "playwright": "^1.60.0",
    "puppeteer-core": "^24.0.0",
    "subset-font": "^2.9.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "vendor": "node tools/vendor-skills.mjs && node tools/vendor-examples.mjs",
    "test": "node --test test/*.test.mjs",
    "index": "node scripts/build-index.mjs"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-rc.2"
  }
}
